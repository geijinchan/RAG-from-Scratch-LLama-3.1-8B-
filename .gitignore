# Git ignore for RAG project

# Python cache and distribution
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-workspace
*.sublime-project

# Project specific
data/documents/*
!data/documents/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/cache/*
!data/cache/.gitkeep
logs/*.log
!logs/.gitkeep
*.csv
*.pkl
*.pth
*.cache

# Environment
.env
.env.local
.env.*.local

# Docker
.dockerignore
docker-compose.override.yml

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# OS specific
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Temporary files
*.tmp
*.bak
*.swp
.temp/
tmp/
