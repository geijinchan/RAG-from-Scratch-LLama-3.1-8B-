# ==========================================
# RAG Application Environment Configuration
# ==========================================

# ==========================================
# API KEYS AND AUTHENTICATION
# ==========================================
HUGGINGFACE_TOKEN=your_huggingface_token_here
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# GPU/COMPUTE CONFIGURATION (ENTERPRISE LEVEL)
# ==========================================
# Use GPU for embeddings (true/false)
USE_GPU=true

# Device: cuda (GPU) or cpu (CPU default)
# Auto-detected if USE_GPU=true and CUDA available
DEVICE=cuda

# GPU Device ID (for multi-GPU systems)
GPU_DEVICE_ID=0

# CUDA Visible Devices (for multi-GPU: "0,1" for first two GPUs)
CUDA_VISIBLE_DEVICES=0

# GPU Memory Fraction (0.0-1.0, 0.9 = use 90% of GPU memory)
ENABLE_GPU_MEMORY_FRACTION=0.9

# PyTorch CUDA Configuration
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Docker Runtime (nvidia for GPU, runc for CPU)
DOCKER_RUNTIME=nvidia

# GPU Count for Docker (number of GPUs to allocate)
GPU_COUNT=1

# ==========================================
# MODEL CONFIGURATION
# ==========================================
EMBEDDING_MODEL=all-mpnet-base-v2
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# LLM PARAMETERS
# ==========================================
LLM_TEMPERATURE=0.7
LLM_MAX_NEW_TOKENS=512
RETRIEVAL_TOP_K=5

# ==========================================
# PDF PROCESSING
# ==========================================
MIN_CHUNK_TOKENS=30
SENTENCE_CHUNK_SIZE=10

# ==========================================
# STREAMLIT CONFIGURATION
# ==========================================
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_MAXUPLOADSIZE=200

# ==========================================
# DATA AND CACHE PATHS
# ==========================================
DATA_DIR=./data
EMBEDDINGS_DIR=./data/embeddings
DOCUMENTS_DIR=./data/documents
LOGS_DIR=./logs
CACHE_DIR=./data/cache

# ==========================================
# LOGGING AND DEBUG
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG=false

# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================
ENVIRONMENT=production

# ==========================================
# EMBEDDING PARAMETERS
# ==========================================
EMBEDDING_BATCH_SIZE=32
CACHE_EMBEDDING_MODEL=true

# ==========================================
# TIMEOUTS (in seconds)
# ==========================================
EMBEDDING_TIMEOUT=300
LLM_TIMEOUT=600

# ==========================================
# FILE SIZE LIMITS
# ==========================================
MAX_PDF_SIZE_MB=50
